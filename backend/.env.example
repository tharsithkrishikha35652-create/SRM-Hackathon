# Gemini AI Configuration (Backend only - never exposed to frontend or Git)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_TIMEZONE=Asia/Kolkata
# Firebase Admin credentials are server-only. Configure one:
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-service-account.json
FIREBASE_PROJECT_ID=mess-mate-418df
# Comma-separated Firebase emails allowed to access manager/reviewer roles.
FIREBASE_MANAGER_EMAILS=
FIREBASE_REVIEWER_EMAILS=
# Local testing defaults allow repeated ratings; set to false for stricter local testing.
# Production/Vercel defaults to false regardless of this example.
# ALLOW_MULTIPLE_FEEDBACK=true
